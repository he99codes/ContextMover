{
  "name": "contextforge-vscode",
  "displayName": "ContextForge",
  "description": "Captures IDE context and bridges it to AI coding agents",
  "version": "0.1.0",
  "publisher": "ContextForge",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextforge.captureContext",
        "title": "ContextForge: Capture Current Context"
      },
      {
        "command": "contextforge.copyContextForLLM",
        "title": "ContextForge: Copy IDE Context For LLM"
      },
      {
        "command": "contextforge.openInLLM",
        "title": "ContextForge: Open LLM With IDE Context"
      },
      {
        "command": "contextforge.startBridge",
        "title": "ContextForge: Start Bridge Server"
      }
    ],
    "configuration": {
      "title": "ContextForge",
      "properties": {
        "contextforge.bridgePort": {
          "type": "number",
          "default": 49152,
          "description": "Local HTTP port for the browser extension bridge"
        },
        "contextforge.maxFilesInContext": {
          "type": "number",
          "default": 10,
          "description": "Max open files to include in context snapshots"
        },
        "contextforge.maxWorkspaceFilesInContext": {
          "type": "number",
          "default": 30,
          "description": "Max workspace files to index into the migrated IDE context"
        },
        "contextforge.maxWorkspaceFileChars": {
          "type": "number",
          "default": 1200,
          "description": "Max characters to capture per indexed workspace file"
        },
        "contextforge.preferredProvider": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "chatgpt",
            "claude",
            "gemini",
            "grok",
            "custom"
          ],
          "description": "Default LLM target to receive IDE context migrations"
        },
        "contextforge.customProviderUrl": {
          "type": "string",
          "default": "",
          "description": "Optional HTTPS URL to open when the preferred provider is set to custom"
        }
      }
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.29.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}