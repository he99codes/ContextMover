(function geminiDOMProbe() {
  const sessionType = document.querySelector('model-response, user-query') ? 'LIKELY-EXISTING' : 'LIKELY-NEW';
  console.log(`\n========== CONTEXTMOVER: GEMINI DOM PROBE [${sessionType}] ==========\n`);

  // ── SECTION 1: Custom web component scan (Gemini uses Angular custom elements) 
  const customTags = [...new Set([...document.querySelectorAll('*')]
    .filter(el => el.tagName.includes('-'))
    .map(el => el.tagName.toLowerCase())
  )].sort();
  console.log('CUSTOM ELEMENTS (web components) on page:');
  customTags.forEach(tag => {
    const count = document.querySelectorAll(tag).length;
    if (count > 0) console.log(`  ${count}x <${tag}>`);
  });

  // ── SECTION 2: Test known Gemini selectors ─────────────────────────────────
  const candidates = [
    'model-response', 'user-query', 'response-container',
    'message-content', 'chat-message', 'conversation-container',
    '[data-message-author]', '[data-turn-id]', '[data-chunk-index]',
    '[class*="response"]', '[class*="query"]', '[class*="user-query"]',
    '[class*="model-response"]', '[class*="conversation-turn"]',
    '[class*="message"]', '[class*="turn"]',
    '.response-content', '.query-content',
    '[jsname]', '[jsaction]',
    'infinite-scroller', 'chat-history',
  ];

  console.log('\nSELECTOR TEST RESULTS:');
  candidates.forEach(sel => {
    try {
      const els = [...document.querySelectorAll(sel)];
      if (els.length > 0) {
        console.log(`\n  ✅ "${sel}" → ${els.length} elements`);
        els.slice(0, 2).forEach((el, i) => {
          const text = el.textContent.trim().replace(/\s+/g,' ').slice(0,100);
          const allAttrs = [...el.attributes].map(a=>`${a.name}="${a.value.slice(0,40)}"`).join(' ');
          console.log(`     [${i}] <${el.tagName.toLowerCase()}> attrs: ${allAttrs.slice(0,150)}`);
          console.log(`     [${i}] text: "${text}"`);
        });
      }
    } catch(e) {}
  });

  // ── SECTION 3: Scan for jsname / jsaction attributes (Angular pattern) ─────
  console.log('\nJSNAME ATTRIBUTES (Angular internal identifiers):');
  const jsnames = [...new Set([...document.querySelectorAll('[jsname]')].map(el => el.getAttribute('jsname')))];
  console.log('  All jsname values (first 20):', jsnames.slice(0,20).join(', '));

  // ── SECTION 4: Find conversation root ─────────────────────────────────────
  console.log('\nCONVERSATION ROOT SEARCH:');
  ['chat-history', 'infinite-scroller', 'conversation-container',
   'chat-window', '[role="main"]', 'main',
   '[class*="conversation"]', '[class*="history"]',
   '[class*="chat-body"]', '[class*="ChatBody"]'].forEach(sel => {
    const el = document.querySelector(sel);
    if (el) {
      console.log(`  "${sel}" → <${el.tagName.toLowerCase()}> | children: ${el.children.length} | scrollHeight: ${el.scrollHeight}`);
    }
  });

  // ── SECTION 5: Shadow DOM check (important for custom elements) ────────────
  console.log('\nSHADOW DOM CHECK:');
  ['model-response', 'user-query', 'response-container', 'chat-history'].forEach(tag => {
    const el = document.querySelector(tag);
    if (el) {
      const hasShadow = !!el.shadowRoot;
      console.log(`  <${tag}> has shadowRoot: ${hasShadow}`);
      if (hasShadow) {
        const shadowChildren = [...el.shadowRoot.querySelectorAll('*')].slice(0,5).map(c => c.tagName.toLowerCase()).join(', ');
        console.log(`    shadowRoot children (first 5): ${shadowChildren}`);
      }
    }
  });

  // ── SECTION 6: Text content sampling ──────────────────────────────────────
  console.log('\nTEXT CONTENT SAMPLING (first 5 substantial text blocks):');
  let count = 0;
  document.querySelectorAll('*').forEach(el => {
