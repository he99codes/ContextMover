# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay — server-side keys (NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay — safe public key (key_id only, not key_secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay subscription plan IDs (create in Razorpay dashboard)
# Pro Monthly — ₹299/month auto-pay subscription
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_placeholder_pro_monthly
# Pro Annual — ₹2,399/year auto-pay subscription
RAZORPAY_PRO_ANNUAL_PLAN_ID=plan_placeholder_pro_annual

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
