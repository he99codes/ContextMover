(function grokDOMProbe() {
  console.log('\n========== CONTEXTMOVER: GROK DOM PROBE ==========\n');
  console.log('URL:', window.location.href);

  // ── SECTION 1: data-* and role attributes scan ─────────────────────────────
  const roleAttrs = {};
  document.querySelectorAll('*').forEach(el => {
    [...el.attributes].forEach(attr => {
      if (/role|author|turn|human|grok|assistant|user|message|speaker/i.test(attr.name + attr.value)) {
        const key = `${attr.name}="${attr.value}"`;
        roleAttrs[key] = (roleAttrs[key]||0)+1;
      }
    });
  });
  console.log('ROLE-RELATED ATTRIBUTES (attr=value : count):');
  Object.entries(roleAttrs).sort((a,b)=>b[1]-a[1]).slice(0,20)
    .forEach(([k,n]) => console.log(`  ${n}x  ${k}`));

  // ── SECTION 2: data-testid scan ────────────────────────────────────────────
  const allTestIds = [...new Set(
    [...document.querySelectorAll('[data-testid]')].map(el => el.dataset.testid)
  )].sort();
  console.log('\nALL data-testid VALUES:\n' + (allTestIds.join('\n') || '(none)'));

  // ── SECTION 3: Test selector patterns ─────────────────────────────────────
  const candidates = [
    '[data-message-author-role]',
    '[data-testid*="message"]', '[data-testid*="turn"]', '[data-testid*="response"]',
    '[class*="message"]', '[class*="Message"]',
    '[class*="response"]', '[class*="Response"]',
    '[class*="human"]', '[class*="Human"]',
    '[class*="grok"]', '[class*="Grok"]',
    '[class*="UserMessage"]', '[class*="BotMessage"]',
    '[class*="AssistantMessage"]', '[class*="ConversationTurn"]',
    '[class*="turn"]', '[class*="Turn"]',
    'article', '[role="article"]',
    '[class*="chat"]', '[class*="Chat"]',
  ];

  console.log('\nSELECTOR TEST RESULTS:');
  candidates.forEach(sel => {
    try {
      const els = [...document.querySelectorAll(sel)];
      if (els.length > 0 && els.some(el => el.textContent.trim().length > 30)) {
        const withText = els.filter(el => el.textContent.trim().length > 30);
        console.log(`\n  ✅ "${sel}" → ${els.length} total, ${withText.length} with text`);
        withText.slice(0,2).forEach((el,i) => {
          const text = el.textContent.trim().replace(/\s+/g,' ').slice(0,100);
          const dataAttrs = [...el.attributes].filter(a=>/^data-/.test(a.name)).map(a=>`${a.name}="${a.value}"`).join(' ');
          console.log(`     [${i}] <${el.tagName.toLowerCase()}> | data: {${dataAttrs}} | class: "${el.className?.toString().slice(0,80)}"`);
          console.log(`     [${i}] text: "${text}"`);
        });
      }
    } catch(e) {}
  });

  // ── SECTION 4: Root container ──────────────────────────────────────────────
  console.log('\nROOT CONTAINER CANDIDATES:');
  ['main', '[role="main"]', '[class*="conversation"]', '[class*="Conversation"]',
   '[class*="thread"]', '[class*="Thread"]', '[class*="messages"]',
   '[class*="ChatContainer"]', '[class*="chat-container"]',
   '[class*="overflow-y"]'].forEach(sel => {
    const el = document.querySelector(sel);
    if (el) {
      const msgNodes = el.querySelectorAll('[class*="message"],[class*="turn"],[data-message-author-role]').length;
      console.log(`  "${sel}" → <${el.tagName.toLowerCase()}> class="${el.className?.toString().slice(0,80)}" | msg-like nodes: ${msgNodes}`);
    }
  });

  // ── SECTION 5: Virtual scroll detection ───────────────────────────────────
  console.log('\nVIRTUAL SCROLL CHECK:');
  document.querySelectorAll('*').forEach(el => {
    const style = window.getComputedStyle(el);
    if (style.overflowY === 'auto' || style.overflowY === 'scroll') {
      const h = el.scrollHeight;
      if (h > 500) {
        console.log(`  overflow-y:${style.overflowY} scrollHeight:${h}px → <${el.tagName.toLowerCase()}> class="${el.className?.toString().slice(0,60)}"`);
      }
    }
  });

  console.log('\n========== END GROK DOM PROBE ==========\n');
})();
