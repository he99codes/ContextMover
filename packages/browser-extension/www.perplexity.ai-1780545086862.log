(function perplexityDOMProbe() {
  console.log('\n========== CONTEXTMOVER: PERPLEXITY DOM PROBE ==========\n');

  // ── SECTION 1: Verify we're on a search result page ───────────────────────
  console.log('Current URL:', window.location.href);
  console.log('Page title:', document.title.slice(0,80));
  const hasMain = !!document.querySelector('main');
  console.log(`<main> element exists: ${hasMain}`);
  if (!hasMain) {
    console.log('⚠️  NO <main> ELEMENT — this confirms the root cause of Prompt 9 bug');
    // Find what IS the outermost content wrapper
    ['#__next > div', '#app', '[id*="root"]', '#root > div', 
     'body > div', '[class*="layout"]', '[class*="Layout"]'].forEach(sel => {
      const el = document.querySelector(sel);
      if (el) console.log(`  Alternative root: "${sel}" → height: ${el.offsetHeight}px, children: ${el.children.length}`);
    });
  }

  // ── SECTION 2: Test known Perplexity selectors ─────────────────────────────
  const candidates = [
    '[data-testid]',
    '[class*="prose"]',
    '[class*="answer"]', '[class*="Answer"]',
    '[class*="response"]', '[class*="Response"]',
    '[class*="query"]', '[class*="Query"]',
    '[class*="thread"]', '[class*="Thread"]',
    '[class*="message"]', '[class*="Message"]',
    '[class*="FollowupQuestion"]', '[class*="followup"]',
    '[class*="UserMessage"]', '[class*="BotMessage"]',
    '[class*="AssistantMessage"]',
    'section', 'article',
    '[role="article"]', '[role="region"]',
  ];

  console.log('\nSELECTOR TEST RESULTS:');
  candidates.forEach(sel => {
    try {
      const els = [...document.querySelectorAll(sel)];
      if (els.length > 0 && els.some(el => el.textContent.trim().length > 50)) {
        const withText = els.filter(el => el.textContent.trim().length > 50);
        console.log(`\n  ✅ "${sel}" → ${els.length} total, ${withText.length} with substantial text`);
        withText.slice(0,2).forEach((el,i) => {
          const text = el.textContent.trim().replace(/\s+/g,' ').slice(0,100);
          const dataAttrs = [...el.attributes].filter(a=>/^data-/.test(a.name)).map(a=>`${a.name}="${a.value}"`).join(' ');
          console.log(`     [${i}] <${el.tagName.toLowerCase()}> data: {${dataAttrs}} class: "${el.className?.toString().slice(0,80)}"`);
          console.log(`     [${i}] text: "${text}"`);
        });
      }
    } catch(e) {}
  });

  // ── SECTION 3: data-testid full scan ──────────────────────────────────────
  const allTestIds = [...new Set(
    [...document.querySelectorAll('[data-testid]')].map(el => el.dataset.testid)
  )].sort();
  console.log('\nALL data-testid VALUES ON PAGE:\n' + (allTestIds.join('\n') || '(none)'));

  // ── SECTION 4: Find the actual page root (since <main> doesn't exist) ──────
  console.log('\nPAGE STRUCTURE (top 3 levels):');
  function describeNode(el, depth=0, maxDepth=3) {
    if (depth > maxDepth) return;
    const tag = el.tagName.toLowerCase();
    const id = el.id ? `#${el.id}` : '';
    const cls = [...el.classList].filter(c=>c.length>3&&c.length<40).slice(0,3).join('.');
    const text = el.textContent.trim().length;
    console.log(`${'  '.repeat(depth)}<${tag}${id}${cls ? '.'+cls : ''}> [textLen=${text}] [children=${el.children.length}]`);
    if (depth < maxDepth) [...el.children].slice(0,4).forEach(c => describeNode(c, depth+1, maxDepth));
  }
  describeNode(document.body, 0, 3);

  // ── SECTION 5: Sources / follow-up question structure ────────────────────
  console.log('\nSPECIAL PERPLEXITY ELEMENTS:');
  ['[class*="source"]', '[class*="citation"]', '[class*="followup"]', 
   '[class*="FollowUp"]', '[class*="related"]', '[class*="SearchResult"]'].forEach(sel => {
    const els = document.querySelectorAll(sel);
    if (els.length) console.log(`  "${sel}" → ${els.length} elements`);
  });

  console.log('\n========== END PERPLEXITY DOM PROBE ==========\n');
})();
